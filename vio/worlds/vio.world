        <name>VIO/Features</name></script></material></visual>
          </link></model><model name="vio_landmark_1"><static>true</static>
          <pose>8 0 2.0 0 0 0</pose><link name="box">
          <collision name="collision"><geometry><box><size>0.8 0.8 4</size></box></geometry></collision>
          <visual name="texture"><geometry><box><size>0.8 0.8 4</size></box></geometry><material><script><uri>file:///home/dut/px4_agent/vio/materials/scripts</uri><uri>file:///home/dut/px4_agent/vio/materials/textures</uri>
        <name>VIO/Features</name></script></material></visual>
