  <description>Managed PX4, Gazebo, MAVROS, VINS-Fusion and drone Agent console launch.</description>
  <maintainer email="dut@dut.local">dut</maintainer>
  <license>Unspecified</license>
  <buildtool_depend>catkin</buildtool_depend>
