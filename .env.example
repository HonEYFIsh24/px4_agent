# Default: one VLM handles language, images and tool calls.
AGENT_ARCHITECTURE=single_vlm
# VLM_* overrides VISION_*, then inherits the existing provider/key.
VLM_MODEL=qwen3-vl-plus
# VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_API_KEY=

# Legacy planner used only with AGENT_ARCHITECTURE=dual_model.
# Put the key in .env, never in source code.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=
# DeepSeek example:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
UAV_BRIDGE_URL=http://127.0.0.1:8765

# Image model for dual_model; also a fallback configuration for single_vlm.
# DashScope defaults to qwen3-vl-plus and inherits the existing URL/key.
VISION_MODEL=qwen3-vl-plus
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_API_KEY=
